{
  "name": "splatr-shape-riot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An endless procedural 2D slash-action game for touch and keyboard.",
  "scripts": {
    "prestart": "npm run build",
    "start": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/check-bundle.mjs",
    "build:poki": "vite build --mode poki && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:preview": "node scripts/preview-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.cjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "puppeteer-core": "24.43.1",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
